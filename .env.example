# --- Database ---
# PostgreSQL 16 connection string (raw-SQL via node-pg-migrate; no ORM runtime).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinic?schema=public"

# --- App ---
# API binds to PORT (default 3001).
PORT=3001
# pino log level: trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# --- Auth (stubbed in E0-S1; E0-S3 wires a real provider) ---
# 32+ random chars; placeholder for cookie signing / OTP hashing salt.
SESSION_SECRET="change-me-to-a-random-32-char-string-min"
