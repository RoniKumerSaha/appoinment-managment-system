# --- Database ---
# PostgreSQL 16 connection string (raw-SQL via node-pg-migrate; no ORM runtime).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinic?schema=public"

# --- App ---
# API binds to PORT (default 3001).
PORT=3001
# pino log level: trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# --- Auth (E0-S3 wires a real JWT provider) ---
# JWT signing secret. MUST be at least 32 BYTES (use `openssl rand -base64 48`).
# The server refuses to boot in ANY env if this is missing or shorter than 32
# bytes — no dev fallback. Treat as a tier-0 secret.
# AUTH_SECRET=

# Token lifetime in seconds. Default 3600 (60 minutes). Refresh tokens land in
# a future hardening story (see deferred-work.md W8); until then, expired
# tokens require the patient to re-authenticate via /patient/otp/verify-now.
# AUTH_TOKEN_TTL_SECONDS=3600

# Mock OTP code used by the dev-only /patient/otp/verify-now route. The route
# is registered ONLY when NODE_ENV ∈ {development, test}. DO NOT set this in
# production — the production allowlist refuses the route regardless, but
# leaving the variable set in a deployed environment signals a misconfiguration.
# MOCK_OTP_CODE=123456
