# Clinic API — environment variables
#
# Copy this file to `.env` and uncomment the variables you need. Production
# deployments MUST set every required variable explicitly; there are no
# dev/test fallback values. Each block below documents the security posture
# and the validation the API performs at boot.

# ─── Auth (E0-S3) ───────────────────────────────────────────────────────────
#
# AUTH_SECRET is the HS256 signing key for patient + staff JWTs. Required in
# every env. Must be ≥ 32 bytes (Buffer.byteLength, UTF-8 encoded — emoji
# count for more bytes than UTF-16 code units). Boot fails with
# `auth_secret_too_short` if shorter.
#
# Generate a random one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# AUTH_SECRET=

# Token TTL in seconds. Default 3600 (60 minutes). Must be a positive
# integer. Boot fails with `auth_ttl_invalid` otherwise.
# AUTH_TOKEN_TTL_SECONDS=3600

# Mock OTP code for the dev/test `/patient/otp/verify-now` route. Default
# `123456`. Production MUST NOT set this AND the route is not registered
# in production regardless (allowlist: development, test). E0-S4 keeps the
# mock for one story; E4-S1 deletes it.
# MOCK_OTP_CODE=123456

# ─── OTP gateway (E0-S4) ────────────────────────────────────────────────────
#
# OTP provider: `log` (dev/test only — writes the raw code to stdout) or
# `twilio` (production — requires the TWILIO_* vars below). Default is
# `log` in development/test, `twilio` otherwise. Boot fails with
# `otp_provider_log_in_production` if `log` is selected in production —
# we refuse rather than silently route plaintext OTPs through prod logs.
# OTP_PROVIDER=log

# OTP TTL in seconds. Default 300 (5 minutes).
# OTP_TTL_SECONDS=300

# Number of consecutive wrong-code verifies that triggers a 10-min lockout.
# Default 3.
# OTP_LOCKOUT_THRESHOLD=3

# Lockout window in seconds. Default 600 (10 minutes).
# OTP_LOCKOUT_SECONDS=600

# Resend cooldown in seconds — minimum gap between consecutive sends.
# Default 30.
# OTP_COOLDOWN_SECONDS=30

# OTP code length in digits. Default 6. The contract is 6 digits; widening
# this requires a code-format audit on E4-S1's modal.
# OTP_CODE_LENGTH=6

# ─── Twilio (E0-S4, prod only) ──────────────────────────────────────────────
#
# Required only when OTP_PROVIDER=twilio. Missing-credential misconfig
# results in 502 from `/patient/otp/send` (the row is rolled back). Set
# these in your prod secret manager, never in version control.
#
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15551234567

# ─── Database ───────────────────────────────────────────────────────────────
#
# Connection string for the Postgres 16 database. Required in every env.
# The API uses raw-SQL via `pg`; no ORM. Used by `getPool()` and the
# DB-touching test suite.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# ─── Logging ────────────────────────────────────────────────────────────────
#
# Log level. Default `info`. Production typically runs at `info`; dev can
# drop to `debug` for verbose request logs. The API redacts `password`,
# `phone_number`, `code`, `authorization`, `cookie`, and `x-auth-claim`
# regardless of level.
# LOG_LEVEL=info

# ─── Server ─────────────────────────────────────────────────────────────────
#
# HTTP port. Default 3001.
# PORT=3001
