{
  "name": "@clinic/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 5173",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo 'no web tests in E0-S1'",
    "test:e7-s7": "node test/run-no-tentative-holds.mjs",
    "test:api-error-body": "node test/run-api-error-body.mjs",
    "test:recurring-client": "node test/run-recurring-client.mjs",
    "test:phone-number": "node test/run-phone-number.mjs",
    "test:reception-schedule": "node test/run-reception-schedule.mjs",
    "test:e7-s4": "node test/run-conflict-modal-singleton.mjs",
    "test:e7-s1": "node test/run-token-only-css.mjs",
    "test:e7-s5-focus": "node test/run-a11y-focus-ring.mjs",
    "test:e7-s5-pills": "node test/run-a11y-status-pills.mjs",
    "test:e7-s5-touch": "node test/run-a11y-touch-targets.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.18.0",
    "@typescript-eslint/parser": "8.18.0",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "8.57.1",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.1.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
